--- /dev/null
+++ b/Volumes/SSD/WiiDev/Devtools/libogc-rs/games/tetris/src/reset_input.rs
@@ -0,0 +1,23 @@
+use core::sync::atomic::{AtomicBool, Ordering};
+
+/// Accept RESET only after the application has observed the button released.
+/// A held startup signal must not enter a blocking wait before the first menu.
+pub struct ResetButton {
+    released_since_start: AtomicBool,
+}
+
+impl ResetButton {
+    pub const fn new() -> Self {
+        Self {
+            released_since_start: AtomicBool::new(false),
+        }
+    }
+
+    pub fn is_pressed(&self, hardware_pressed: bool) -> bool {
+        if !hardware_pressed {
+            self.released_since_start.store(true, Ordering::Relaxed);
+            return false;
+        }
+        self.released_since_start.load(Ordering::Relaxed)
+    }
+}

diff --git a/Volumes/SSD/WiiDev/Devtools/libogc-rs/games/tetris/tests/tetris_reset.rs b/Volumes/SSD/WiiDev/Devtools/libogc-rs/games/tetris/tests/tetris_reset.rs
new file mode 100644
index 0000000..312f46a
--- /dev/null
+++ b/Volumes/SSD/WiiDev/Devtools/libogc-rs/games/tetris/tests/tetris_reset.rs
@@ -0,0 +1,32 @@
+#[path = "../src/reset_input.rs"]
+mod reset_input;
+
+use reset_input::ResetButton;
+
+#[test]
+fn held_startup_signal_does_not_request_reset() {
+    let button = ResetButton::new();
+    for _ in 0..120 {
+        assert!(!button.is_pressed(true));
+    }
+}
+
+#[test]
+fn reset_is_available_after_startup_signal_is_released() {
+    let button = ResetButton::new();
+    assert!(!button.is_pressed(true));
+    assert!(!button.is_pressed(false));
+    assert!(button.is_pressed(true));
+    assert!(button.is_pressed(true));
+    assert!(!button.is_pressed(false));
+    assert!(button.is_pressed(true));
+}
+
+#[test]
+fn normal_launch_accepts_the_first_new_press() {
+    let button = ResetButton::new();
+    assert!(!button.is_pressed(false));
+    assert!(!button.is_pressed(false));
+    assert!(button.is_pressed(true));
+    assert!(!button.is_pressed(false));
+}
